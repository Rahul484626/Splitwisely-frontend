{
  "openapi": "3.0.3",
  "info": {
    "title": "Splitwisely API",
    "version": "0.4.0",
    "description": "Expense-splitting REST API. Amounts are integer minor units (paise for INR)."
  },
  "servers": [{ "url": "/api/v1" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "defaultCurrency": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "GroupSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "currency": { "type": "string" },
          "createdBy": { "type": "string", "format": "uuid" },
          "myNetMinor": { "type": "integer" },
          "memberCount": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "groupId": { "type": "string", "format": "uuid" },
          "description": { "type": "string" },
          "amountMinor": { "type": "integer" },
          "currency": { "type": "string" },
          "paidBy": { "type": "string", "format": "uuid" },
          "splitType": { "type": "string", "enum": ["equal", "exact", "percentage", "shares"] },
          "splits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": { "type": "string", "format": "uuid" },
                "shareMinor": { "type": "integer" }
              }
            }
          }
        }
      },
      "Balances": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": { "type": "string" },
                "netMinor": { "type": "integer" }
              }
            }
          },
          "simplified": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fromUserId": { "type": "string" },
                "toUserId": { "type": "string" },
                "amountMinor": { "type": "integer" }
              }
            }
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "youOweMinor": { "type": "integer" },
          "youAreOwedMinor": { "type": "integer" },
          "overallMinor": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": { "description": "OK" },
          "503": { "description": "DB down" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" },
                  "defaultCurrency": { "type": "string", "default": "INR" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh tokens",
        "security": [],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Invalid" } }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout",
        "security": [],
        "responses": { "204": { "description": "No content" } }
      }
    },
    "/me": {
      "get": {
        "summary": "Current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      },
      "patch": {
        "summary": "Update profile",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/dashboard": {
      "get": {
        "summary": "Dashboard totals",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Dashboard" } }
            }
          }
        }
      }
    },
    "/groups": {
      "get": {
        "summary": "List my groups",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "summary": "Create group",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/groups/{groupId}": {
      "get": {
        "summary": "Group detail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/groups/{groupId}/expenses": {
      "get": {
        "summary": "List expenses",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "summary": "Create expense",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/groups/{groupId}/balances": {
      "get": {
        "summary": "Group balances",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Balances" } }
            }
          }
        }
      }
    },
    "/groups/{groupId}/settlements": {
      "post": {
        "summary": "Record settlement",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "201": { "description": "Created" } }
      },
      "get": {
        "summary": "List settlements",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/activity": {
      "get": {
        "summary": "Activity feed",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/friends": {
      "get": {
        "summary": "Friends sharing groups",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
